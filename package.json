{
  "name": "nielsen-processor",
  "version": "4.0.0",
  "description": "Nielsen File Processor — Save-As + DQ Checks + Azure Upload",
  "main": "server.js",
  "dependencies": {
    "@azure/storage-blob": "10.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "scripts": "server.js",
    "assets": [
      "index.html",
      "DQChecks/**/*"
    ],
    "targets": [
      "node18-win-x64",
      "node18-macos-x64",
      "node18-macos-arm64"
    ],
    "outputPath": "dist"
  }
}